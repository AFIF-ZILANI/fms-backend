// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  // For the one-active-payout-account index (a partial unique). Documented in Prisma 7.8.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  EMPLOYEE
  CUSTOMER
  SUPPLIER
  DOCTOR
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

/// Where the employee is in the hiring paperwork sequence documented in
/// docs/employee_hire.md. Set by hand -- there is no workflow engine behind it.
enum EmploymentStatus {
  APPOINTED
  PROBATION
  CONFIRMED
  TERMINATED
}

enum SupplierRoleNames {
  SALES_MAN
  OWNER
  DISTRIBUTOR
  DEALER
  WHOLESALER
  RETAILER
  MANUFACTURER
  IMPORTER
  REPRESENTATIVE
}

enum HouseType {
  BROODER
  GROWER
  LAYER
}

/// Where an empty house is in its turnaround. Ignored while birds are in the
/// house -- occupancy is derived from BatchHouseBalance, not stored here.
enum HousePhase {
  READY
  CLEANING
  DISINFECTING
  RESTING
  MAINTENANCE
}

enum BatchStatus {
  RUNNING
  CLOSED
  SOLD
}

enum Phase {
  BROODER
  GROWER
}

enum BirdBreeds {
  CLASSIC
  HIBREED
  PAKISTHANI
  KEDERNATH
  FAOMI
  TIGER
}

enum AllocationReason {
  INITIAL // chicks placed into first house
  TRANSFER // house → house move
  ADJUSTMENT // correction
}

enum TimePeriods {
  MORNING
  NOON
  AFTERNOON
  EVENING
  NIGHT
  MIDNIGHT
  LATENIGHT
}

enum FeedType {
  PRE_STARTER
  STARTER
  GROWER
  FINISHER
  LAYER
}

enum CostType {
  DIRECT // traceable to one batch
  SHARED_PERIOD // recurring, farm-wide, allocated later by bird-days
  SHARED_CAPITAL // equipment/assets, depreciated via useful_life_batches
}

enum DiscountType {
  FLAT // discount_value is a currency amount
  PERCENT // discount_value is a percentage (0-100) of the amount it discounts
}

enum StockUnitStatus {
  UNASSIGNED // printed, not yet bound to a purchase
  IN_STOCK // bound, sitting in storage, untouched
  IN_USE // opened/depleting (medicine, vaccine) or currently assigned to a batch (equipment)
  CONSUMED // fully depleted — medicine/vaccine only
  DISPOSED // written off — expired, damaged, discarded
}

enum AllocationType {
  ALLOCATION // warehouse -> house (unit had no prior house, or its last event was a RETURN)
  REALLOCATION // house -> house (unit was already at a house)
  RETURN // house -> warehouse (house_id null on this row)
}

enum AssetStatus {
  ACTIVE
  RETIRED
  DISPOSED
}

enum StockDirection {
  IN
  OUT
}

enum StockReason {
  PURCHASE
  TRANSFER
  CONSUMPTION
  WASTAGE
  EXPIRED
  ADJUSTMENT
  OPENING_BALANCE
}

enum LocationType {
  WAREHOUSE
  HOUSE
  DISPOSAL
}

enum RefType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  TRANSFER
}

enum OrganizationRole {
  MANUFACTURER
  IMPORTER
  MARKETER
  DISTRIBUTOR
}

enum BirdGrade {
  HIGH
  LOW
  CULL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MFS
}

enum MfsType {
  BKASH
  NAGAD
  ROCKET
}

enum PaymentType {
  INCOMING
  OUTGOING
}

enum PaymentRefType {
  SALE
  BIRD_SALE
  PURCHASE
  EXPENSE
  /// The cash-book shadow of a confirmed PayrollPayout, emitted by markPaid and
  /// pointing at the payout. Not accepted by POST /payments: a salary payment
  /// still cannot be authored here, because Payment cannot require proof of
  /// transfer. See docs/payroll-ledger-bridge.md.
  PAYROLL
}

enum PerformanceCriterion {
  ATTENDANCE_PERFECT
  EARLY_PROBLEM_REPORT
  SUGGESTION_IMPLEMENTED
  ZERO_NEGLIGENT_LOSS
  ACCURATE_DATA_ENTRY
  BIOSECURITY_FOLLOWED
  HELPED_COWORKER
  EXTRA_TASK_COMPLETED
  TEAM_TARGET_HIT
  CONFLICT_RESOLVED
  FALSIFIED_RECORD
  NEGLIGENT_LOSS
  BIOSECURITY_VIOLATION
  CONCEALED_PROBLEM
  MISSED_CRITICAL_TASK
  EQUIPMENT_DAMAGE
  CONDUCT_ISSUE
  TEAM_SUPERVISION_FAILURE
  UNEXCUSED_ABSENCE
  PATTERN_LATENESS
  OTHER
}

/// An entry is never deleted -- a wrong one is VOIDED with a reason, leaving both
/// the entry and the correction on record.
enum ScoreEntryStatus {
  ACTIVE
  DISPUTED
  VOIDED
}

enum PayoutMethod {
  BANK
  BKASH
  NAGAD
  ROCKET
  CASH
}

enum Religion {
  ISLAM
  HINDU
  CHRISTIANITY
  BUDDHISM
  OTHER
}

enum IngestStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum IngestPortion {
  main
  cull
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
  CONFIRMED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AlertTypes {
  EMPLOYEE
  BATCH
  FEED
  MEDICINE
  SYSTEM
}

enum AlertLevels {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
}

enum AlertActionTypes {
  PAY
  REASSIGN
  MARK_RESOLVED
}

// Stays a hard enum, unlike TaskType/Tasks below: it's the state machine the
// complete/cancel endpoints enforce, not admin-facing data. Softening it would
// mean the server can't reason about its own transitions.
enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

// ════════════════════════════════════════════════════════════════════
// SOFT-CODED LOOKUPS (categories, units) -- see
// docs/superpowers/specs/2026-08-18-soft-coded-categories-and-units-design.md
// ════════════════════════════════════════════════════════════════════

model ItemCategory {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items Item[]
}

model Unit {
  id           String   @id @default(uuid())
  code         String   @unique
  label        String
  is_active    Boolean  @default(true)
  // Canonical base-unit hierarchy: exactly 6 units have is_base = true (LITER, KG, UNIT, DOSE, PCS,
  // METER) -- Item.unit is restricted to these. Mass/volume anchor at KG/LITER so bulk feed (e.g. 30
  // metric ton = 30,000 KG) stays a small, non-overflowing number. Every other unit optionally names
  // which base family it converts to (base_unit) and, when the ratio is a physical constant
  // (MetricTon=1000, G=0.001, ML=0.001, Ft=0.3048, ...), the fixed factor to that base -- a null
  // fixed_factor means the conversion is package-size-dependent and entered per item
  // (ItemUnit.factor_to_base) instead. G and ML are derived units (base_unit KG/LITER) used for fine
  // dosing. base_unit is null both for the 6 base units themselves and for generic cross-family
  // package units (e.g. Container, which can hold either a liquid or a solid depending on the item).
  is_base      Boolean  @default(false)
  base_unit    String?
  baseUnitRef  Unit?    @relation("UnitFamily", fields: [base_unit], references: [code], onUpdate: Cascade)
  derivedUnits Unit[]   @relation("UnitFamily")
  fixed_factor Decimal? @db.Decimal(14, 4)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  items               Item[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  itemUnitConversions ItemUnit[]
  consumptions        Consumption[]
  stockTransfers      StockTransfer[]
}

model ExpenseCategoryLookup {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  expenses Expense[]
}

/// Farm employee roles and the standard salary each one carries. A table rather
/// than an enum so the owner can add, rename and re-price roles in Settings
/// without a migration. The salary here is the standard for the role;
/// Employees.reference_salary overrides it per person.
model EmployeeRole {
  id    String @id @default(uuid())
  /// Derived from the label once at create and never regenerated on rename --
  /// Employees.role routes on it, so a rename must not break the reference.
  code  String @unique
  label String
  /// R for anyone in this role who carries no override. Required: a role with no
  /// standard salary cannot be hired into, and making it optional would add an
  /// impossible-to-reach failure path to every payroll run.
  ///
  /// ponytail: one current figure, not an effective-dated history. Back-dating
  /// payroll for an override-less employee after a change would use today's rate;
  /// PayrollRecord snapshots everything once generated, so only ungenerated past
  /// months are exposed. If that bites, this becomes EmployeeRoleSalary with
  /// active_from/active_to, exactly like EmployeePayoutAccount.
  reference_salary Decimal  @db.Decimal(10, 2)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  employees Employees[]
}

model SupplierSupplyCategory {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  supplierLinks SupplierSupplyLink[]
}

model SupplierSupplyLink {
  supplier_id String
  supplier    Suppliers              @relation(fields: [supplier_id], references: [id])
  category_id String
  category    SupplierSupplyCategory @relation(fields: [category_id], references: [id])

  @@id([supplier_id, category_id])
}

// Soft-coded replacement for what would otherwise be an enum of "which screen
// does this task open". Admin adds/renames/deactivates rows -- no migration,
// and the mobile app can gain a screen in a release without the server moving.
// The app maps code -> screen and falls back to a plain mark-done task for any
// code it doesn't recognise, which is what makes a DB-stored list safe here.
model TaskType {
  id         String   @id @default(uuid())
  // Like every lookup, code is generated ONCE at create and never recomputed on
  // rename -- here it is also the mobile app's routing key, so moving it would
  // silently break routing with no error anywhere.
  code       String   @unique
  label      String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tasks Tasks[]
}

// The catalogue a Manager assigns from. Several tasks can share one TaskType --
// "Morning environment reading" and "Night environment reading" are two
// assignable tasks that open the same screen, which is why the two levels exist.
model Tasks {
  id           String    @id @default(uuid())
  code         String    @unique // immutable, same rule as TaskType.code
  label        String
  task_type_id String? // null = plain mark-done task, e.g. "Fix water line"
  task_type    TaskType? @relation(fields: [task_type_id], references: [id])
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  assignments EmployeeTaskAssignment[]

  @@index([task_type_id])
}

// ════════════════════════════════════════════════════════════════════
// PEOPLE
// ════════════════════════════════════════════════════════════════════

model Profiles {
  id         String   @id @default(uuid())
  email      String?  @unique
  name       String
  mobile     String   @unique
  address    String?
  avatar_id  String?
  avatar     Avatars? @relation(fields: [avatar_id], references: [id], onDelete: SetNull)
  role       UserRole
  is_active  Boolean  @default(true) // never hard-delete a Profile — it's referenced by every accountability field below
  // Login credentials (ADMIN and EMPLOYEE profiles only). Null hash = cannot log in.
  password_hash        String? // scrypt, see lib/password.ts
  must_change_password Boolean   @default(false) // temp password handed out at hire / reset
  password_changed_at  DateTime? // stamped into every session token; changing it signs all sessions out
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employees?
  admins    Admins?
  customers Customers?
  suppliers Suppliers?
  doctors   Doctors?

  // accountability back-relations — every action-record's actor field resolves here
  weightRecords           WeightRecords[]
  payments                Payment[]
  mortalityLogsRecorded   MortalityLog[]
  allocationsRecorded     BatchHouseAllocation[]
  consumptionsRecorded    Consumption[]
  purchasesRecorded       Purchase[]
  expensesRecorded        Expense[]
  salesRecorded           Sale[]
  birdSalesRecorded       BirdSale[]
  environmentRecordsTaken EnvironmentRecords[]
  scoresGiven             PerformanceScoreEntry[] @relation("ScoreGivenBy")
  scoresApproved          PerformanceScoreEntry[] @relation("ScoreApprovedBy")
  payoutAccountsVerified  EmployeePayoutAccount[] @relation("PayoutAccountVerifiedBy")
  payoutsPaid             EmployeePayout[]        @relation("PayoutPaidBy")
  bonusEventsCreated      BonusEvent[]
  scoresVoided            PerformanceScoreEntry[] @relation("ScoreVoidedBy")
  scoresAcknowledged      PerformanceScoreEntry[] @relation("ScoreAcknowledgedBy")
  payoutAccountsClosed    EmployeePayoutAccount[] @relation("PayoutAccountClosedBy")
  devicesRevoked          Device[]                @relation("DeviceRevokedBy")
  employeesTerminated     Employees[]             @relation("EmployeeTerminatedBy")
  inventoryAdjustments    InventoryAdjustment[]
  stockTransfersRecorded  StockTransfer[]
  medicationsGiven        Medications[]
  vaccinationsGiven       Vaccinations[]
  auditLogs               AuditLog[]
  tasksAssigned           EmployeeTaskAssignment[]
  stockUnitsBound         StockUnit[]
  devices                 Device[]
  pairingCodes            PairingCode[]
  ingestedSales           IngestedSale[]
  ingestedSalesReviewed   IngestedSale[]         @relation("IngestedSaleReviewer")
}

model Employees {
  id           String            @id @default(uuid())
  profile_id   String            @unique
  profile      Profiles          @relation(fields: [profile_id], references: [id], onDelete: Restrict)
  role     String
  roleRef  EmployeeRole @relation(fields: [role], references: [code], onUpdate: Cascade)
  /// An exception to the role's standard salary. Null means "use the role's" --
  /// resolved by referenceSalaryFor() in lib/payroll-math.ts, never read raw.
  reference_salary Decimal? @db.Decimal(10, 2)
  joining_date DateTime          @default(now())
  rating       Float?            @default(0)

  // ── Hire profile (docs/employee_hire.md) ────────────────────────────────
  // Nullable in the database, required in the create validator: rows that
  // predate this migration have none of it, but no new hire may skip it.
  // The photo is not here -- it reuses Profiles.avatar_id -> Avatars.
  date_of_birth    DateTime? // age is derived at render time, never stored
  marital_status   MaritalStatus?
  education        String? // highest level completed; the allowed set lives in the validator
  experience       String? // where and what -- the note beside experience_years
  experience_years Int? // whole years of relevant prior work
  nid_number       String? // the number only; the scan stays in the paper file
  // Sensitive, and optional on purpose: it only decides who a festival bonus proposes.
  // Never required, and left out of the payslip response. See docs/superpowers/specs/2026-09-30-festival-bonus-design.md.
  religion         Religion?

  // Emergency contact -- exactly one per employee, so flat columns, not a table.
  emergency_name     String?
  emergency_relation String? // free text: the form offers a list plus "other"
  emergency_phone    String?
  emergency_email    String?
  emergency_address  String?

  // Reference is either a current employee or an outside person -- never both.
  // Enforced in the service, and expressed in the form as a segmented toggle so
  // the invalid combination can't be entered (same shape as
  // EmployeeTaskAssignment.house_id vs location_note).
  reference_employee_id String?
  reference_employee    Employees?  @relation("EmployeeReference", fields: [reference_employee_id], references: [id], onDelete: SetNull)
  referredHires         Employees[] @relation("EmployeeReference")
  reference_name        String?
  reference_phone       String?
  reference_address     String?

  employment_status  EmploymentStatus @default(APPOINTED)
  probation_end_date DateTime?
  // When employment ended. Payroll may still be generated for the month they
  // left in -- the final month's wage is owed -- but not for months after it.
  terminated_at      DateTime?
  terminated_by_id   String? // who ended it; cleared on reinstate
  terminated_by      Profiles?  @relation("EmployeeTerminatedBy", fields: [terminated_by_id], references: [id])

  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  performanceScores PerformanceScoreEntry[]
  payrollRecords    PayrollRecord[]
  bonuses           Bonus[]
  taskAssignments   EmployeeTaskAssignment[]
  payoutAccounts    EmployeePayoutAccount[]

  @@index([role])
  @@index([reference_employee_id])
}

model Admins {
  id         String   @id @default(uuid())
  profile_id String   @unique
  profile    Profiles @relation(fields: [profile_id], references: [id], onDelete: Restrict)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Customers {
  id         String   @id @default(uuid())
  profile_id String   @unique
  profile    Profiles @relation(fields: [profile_id], references: [id], onDelete: Restrict)
  company    String?
  rating     Float?   @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sales     Sale[]
  birdSales BirdSale[]
}

model Suppliers {
  id          String               @id @default(uuid())
  profile_id  String               @unique
  profile     Profiles             @relation(fields: [profile_id], references: [id], onDelete: Restrict)
  role        SupplierRoleNames
  supplyLinks SupplierSupplyLink[]
  company     String?
  is_active   Boolean              @default(true)
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt

  items     Item[]
  purchases Purchase[]
}

model Doctors {
  id          String   @id @default(uuid())
  profile_id  String   @unique
  profile     Profiles @relation(fields: [profile_id], references: [id], onDelete: Restrict)
  specialty   String?
  position    String?
  degrees     String[]
  institution String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  medications  Medications[]
  vaccinations Vaccinations[]
}

model Avatars {
  id         String   @id @default(uuid())
  public_id  String
  image_url  String
  created_at DateTime @default(now())

  profiles Profiles[]
}

// ════════════════════════════════════════════════════════════════════
// FARM STRUCTURE
// ════════════════════════════════════════════════════════════════════

model Houses {
  id         String    @id @default(uuid())
  name       String
  type       HouseType
  number     Int
  capacity   Int? // max birds this house can hold; null = no limit tracked
  phase      HousePhase @default(READY) // operator-set turnaround stage; only meaningful while the house is empty
  is_active  Boolean   @default(true) // never hard-delete -- mortality/allocation/environment history attaches once a batch runs through it
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  weightRecords         WeightRecords[]
  allocationsTo         BatchHouseAllocation[]   @relation("ToHouse")
  allocationsFrom       BatchHouseAllocation[]   @relation("FromHouse")
  batchHouseBalances    BatchHouseBalance[]
  mortalityLogs         MortalityLog[]
  consumptions          Consumption[]
  environmentRecords    EnvironmentRecords[]
  stockHouseAllocations StockHouseAllocation[]
  inventoryAdjustments  InventoryAdjustment[]
  birdSales             BirdSale[]
  taskAssignments       EmployeeTaskAssignment[]

  // Numbers repeat across types on this farm (Brooder 1 and Grower 1 are different sheds) but never
  // within one. Also serves lookups by type, so no separate index on it.
  @@unique([type, number])
}

model Batches {
  id                    String      @id @default(uuid())
  batch_code            String      @unique
  breed                 BirdBreeds
  phase                 Phase       @default(BROODER)
  status                BatchStatus @default(RUNNING)
  starting_date         DateTime    @default(now())
  expected_selling_date DateTime
  actual_end_date       DateTime? // set when status → CLOSED/SOLD; drives bird-days + depreciation triggers
  initial_chick_count   Int
  init_chicks_avg_wt    Float
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt

  purchaseItems      PurchaseItem[]
  houseAllocations   BatchHouseAllocation[]
  houseBalances      BatchHouseBalance[]
  mortalityLogs      MortalityLog[]
  weightRecords      WeightRecords[]
  medications        Medications[]
  vaccinations       Vaccinations[]
  environmentRecords EnvironmentRecords[]
  consumptions       Consumption[]
  expenses           Expense[]
  birdSales          BirdSale[]
  feedingPrograms    BatchFeedingProgram[]
  assetDepreciations AssetDepreciation[]

  @@index([status])
}

model BatchHouseAllocation {
  id              String           @id @default(uuid())
  batch_id        String
  batch           Batches          @relation(fields: [batch_id], references: [id], onDelete: Restrict)
  from_house_id   String?
  from_house      Houses?          @relation("FromHouse", fields: [from_house_id], references: [id], onDelete: Restrict)
  to_house_id     String?
  to_house        Houses?          @relation("ToHouse", fields: [to_house_id], references: [id], onDelete: Restrict)
  quantity        Int // birds moved in THIS event (always positive) — stagger a multi-day shift as several rows
  reason          AllocationReason
  recorded_by_id  String
  recorded_by     Profiles         @relation(fields: [recorded_by_id], references: [id])
  occurred_at     DateTime         @default(now())
  created_at      DateTime         @default(now())
  idempotency_key String           @unique // client-generated; prevents double-insert on offline sync retry

  @@index([batch_id])
  @@index([from_house_id])
  @@index([to_house_id])
}

model BatchHouseBalance {
  id         String   @id @default(uuid())
  batch_id   String
  batch      Batches  @relation(fields: [batch_id], references: [id])
  house_id   String
  house      Houses   @relation(fields: [house_id], references: [id])
  quantity   Int
  updated_at DateTime @updatedAt
  // Cached count. MUST be updated in the same transaction as any BatchHouseAllocation,
  // MortalityLog, or BirdSale insert that touches this batch+house — those are the only
  // three things that can change it now that generic house events are gone (a force-close
  // writes ADJUSTMENT allocations for the same reason). If it's ever updated out of band,
  // it will drift and nobody will notice until the numbers are wrong.
  // Decrement with `updateMany where quantity >= n` so the check and the write are one
  // statement. A CHECK (quantity >= 0), added in a hand-written migration because Prisma
  // can't express it, is the backstop.

  @@unique([batch_id, house_id])
  @@index([house_id])
}

model MortalityLog {
  id              String   @id @default(uuid())
  batch_id        String
  batch           Batches  @relation(fields: [batch_id], references: [id])
  house_id        String
  house           Houses   @relation(fields: [house_id], references: [id])
  count_died      Int
  cause_note      String?
  date            DateTime
  recorded_by_id  String
  recorded_by     Profiles @relation(fields: [recorded_by_id], references: [id])
  created_at      DateTime @default(now())
  idempotency_key String   @unique // client-generated; prevents double-insert on offline sync retry

  @@index([batch_id])
  @@index([house_id, date])
}

// ════════════════════════════════════════════════════════════════════
// ITEMS & PURCHASING (lot costing lives here)
// ════════════════════════════════════════════════════════════════════

model Item {
  id                    String       @id @default(uuid())
  name                  String
  normalized_key        String       @unique // app-computed dedup key — prevents "Amoxicillin" and "amoxicillin" splitting inventory
  category              String
  categoryRef           ItemCategory @relation(fields: [category], references: [code], onUpdate: Cascade)
  unit                  String
  unitRef               Unit         @relation(fields: [unit], references: [code], onUpdate: Cascade)
  meta_data             Json?
  reorder_level         Decimal?     @db.Decimal(13, 4)
  preferred_reorder_qty Decimal?     @db.Decimal(13, 4)
  lead_time_days        Int?
  is_active             Boolean      @default(true)
  // Which of the two stock-tracking mechanisms this item uses: true = individually QR-coded
  // (StockUnit/StockHouseAllocation -- medicine, vaccine, equipment), false = aggregate quantity
  // only (StockLedger/StockTransfer -- feed, husk, etc). Gates bind(). Transfers ARE allowed for
  // coded items (relocate() links its StockTransfer so the ledger stays in step). The mode is
  // fixed once the item has been purchased (ItemService.update).
  is_unit_tracked       Boolean      @default(false)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  purchaseItems        PurchaseItem[]
  ledgerEntries        StockLedger[]
  consumptions         Consumption[]
  saleItems            SaleItem[]
  suppliers            Suppliers[]
  itemUnits            ItemUnit[]
  feedingPrograms      BatchFeedingProgram[]
  itemOrganizations    ItemOrganization[]
  inventoryAdjustments InventoryAdjustment[]
  stockTransfers       StockTransfer[]

  @@index([category])
}

model ItemUnit {
  id             String   @id @default(uuid())
  item_id        String
  item           Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  unit           String
  unitRef        Unit     @relation(fields: [unit], references: [code], onUpdate: Cascade)
  factor_to_base Decimal  @db.Decimal(14, 4) // 1 of `unit` = this many of Item.unit
  // Purpose flags -- one conversion factor per unit can serve either or both flows.
  // toBaseQuantity() filters on whichever flag matches the caller (purchase.service
  // vs consumption.service), so a unit valid for buying isn't automatically valid for use.
  is_purchasable Boolean  @default(true)
  is_usable      Boolean  @default(false)
  created_at     DateTime @default(now())

  @@unique([item_id, unit])
}

model Purchase {
  id             String        @id @default(uuid())
  supplier_id    String?
  supplier       Suppliers?    @relation(fields: [supplier_id], references: [id])
  // Every purchase lands in a warehouse (the validator has always required it, and the stock-ledger
  // rows it writes are tagged with it).
  warehouse_id   String
  warehouse      Warehouses    @relation(fields: [warehouse_id], references: [id])
  invoice_no     String?
  purchase_date  DateTime
  // Global discount, applied to the sum of the (already net-of-their-own-discount) line totals.
  // Null discount_value = no global discount. total_amount is always the net figure -- everything
  // that reads it (due_amount, Payment reconciliation, Analytics) needs no discount-awareness of its own.
  discount_type  DiscountType?
  discount_value Decimal?      @db.Decimal(10, 2)
  total_amount   Decimal       @db.Decimal(10, 2)
  paid_amount    Decimal       @db.Decimal(10, 2)
  due_amount     Decimal       @db.Decimal(10, 2)
  recorded_by_id String
  recorded_by    Profiles      @relation(fields: [recorded_by_id], references: [id])
  created_at     DateTime      @default(now())

  items PurchaseItem[]

  @@index([supplier_id, purchase_date])
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchase_id     String
  purchase        Purchase      @relation(fields: [purchase_id], references: [id])
  item_id         String
  item            Item          @relation(fields: [item_id], references: [id])
  batch_id        String? // set for chicks — the batch this delivery funds. Repeatable: no unique
  batch           Batches?      @relation(fields: [batch_id], references: [id]) // constraint blocks a 2nd delivery at a different price/date.
  quantity        Decimal       @db.Decimal(10, 3)
  unit            String
  unitRef         Unit          @relation(fields: [unit], references: [code], onUpdate: Cascade)
  base_quantity   Decimal       @db.Decimal(13, 4) // quantity converted to Item.unit, snapshotted at write time
  unit_price      Decimal       @db.Decimal(10, 2)
  // Per-line discount, e.g. a supplier knocking a few taka off one line. Null discount_value = none.
  discount_type   DiscountType?
  discount_value  Decimal?      @db.Decimal(10, 2)
  // Net of this line's own discount -- (quantity * unit_price) minus the discount above. This is
  // what feeds Purchase.total_amount and stock valuation, so discounts need no special-casing there.
  total_price     Decimal       @db.Decimal(10, 2)
  mfg_date        DateTime?
  expiration_date DateTime?
  created_at      DateTime      @default(now())

  stockUnits StockUnit[]

  @@index([purchase_id])
  @@index([item_id])
  @@index([batch_id])
}

// ════════════════════════════════════════════════════════════════════
// PHYSICAL UNIT TRACKING (medicine, vaccine, equipment)
// ════════════════════════════════════════════════════════════════════

model StockUnit {
  // id is the QR payload itself — printed directly, no separate human-readable code.
  // A physical unit = one row: which PurchaseItem (lot) it came from, and its lifecycle status.
  // No quantity stored — a unit's remaining amount is derived (lot base_quantity ÷ unit count on
  // that PurchaseItem, minus its Consumption draws). Current location lives in StockHouseAllocation.
  id               String          @id @default(uuid())
  purchase_item_id String? // null = blank, pre-printed, not yet bound to a lot
  purchase_item    PurchaseItem?   @relation(fields: [purchase_item_id], references: [id])
  status           StockUnitStatus @default(UNASSIGNED)
  bound_at         DateTime? // when this unit was scan-bound to its lot
  // Who bound it. Deliveries land at the farm gate, not an office desk, so this
  // is a field action -- FEATURES.md §3.3/§4 both name this accountability field.
  bound_by_id      String?
  bound_by         Profiles?       @relation(fields: [bound_by_id], references: [id])
  created_at       DateTime        @default(now())

  consumptions     Consumption[]
  houseAllocations StockHouseAllocation[]
  asset            Asset?

  @@index([purchase_item_id])
  @@index([status])
}

model StockHouseAllocation {
  // Event log of where a coded unit physically is. First row = left the warehouse (origin warehouse
  // derivable via purchase_item → purchase); later rows = house→house moves (A→B→C). Current location
  // = latest row by occurred_at. Batch is NOT stored — inferred from whichever batch occupied this
  // house at occurred_at (see BatchHouseAllocation / BatchHouseBalance).
  id                String         @id @default(uuid())
  stock_unit_id     String
  stock_unit        StockUnit      @relation(fields: [stock_unit_id], references: [id])
  house_id          String? // null = returned to the warehouse
  house             Houses?        @relation(fields: [house_id], references: [id], onDelete: Restrict)
  type              AllocationType
  // Optional link to the aggregate-quantity move this physical unit was part of -- e.g. 10 units
  // scanned into one "allocate 10L to House Y" batch share one StockTransfer (and its 2 StockLedger
  // rows), so the ledger stays one movement instead of fragmenting into one pair per unit, while
  // this field still lets you trace that movement back to the exact units. Set by the caller
  // (relocate() trusts it, doesn't derive it), so it's optional and unrelated moves just omit it.
  stock_transfer_id String?
  stock_transfer    StockTransfer? @relation(fields: [stock_transfer_id], references: [id], onDelete: SetNull)
  occurred_at       DateTime       @default(now())
  created_at        DateTime       @default(now())
  idempotency_key   String         @unique // client-generated; prevents double-insert on offline sync retry

  @@index([stock_unit_id])
  @@index([house_id, occurred_at])
  @@index([stock_transfer_id])
}

model Asset {
  id                  String      @id @default(uuid())
  stock_unit_id       String      @unique
  stock_unit          StockUnit   @relation(fields: [stock_unit_id], references: [id])
  name                String
  purchase_cost       Decimal     @db.Decimal(10, 2)
  purchase_date       DateTime
  useful_life_batches Int
  status              AssetStatus @default(ACTIVE)
  created_at          DateTime    @default(now())

  depreciations AssetDepreciation[]
}

model AssetDepreciation {
  id          String   @id @default(uuid())
  asset_id    String
  asset       Asset    @relation(fields: [asset_id], references: [id])
  batch_id    String
  batch       Batches  @relation(fields: [batch_id], references: [id])
  amount      Decimal  @db.Decimal(10, 2) // purchase_cost / useful_life_batches, computed at batch close
  computed_at DateTime @default(now())

  @@unique([asset_id, batch_id])
}

// ════════════════════════════════════════════════════════════════════
// CONSUMPTION, TREATMENT & MONITORING
// ════════════════════════════════════════════════════════════════════

model Consumption {
  id              String     @id @default(uuid())
  batch_id        String?
  batch           Batches?   @relation(fields: [batch_id], references: [id])
  house_id        String
  house           Houses     @relation(fields: [house_id], references: [id])
  item_id         String
  item            Item       @relation(fields: [item_id], references: [id])
  stock_unit_id   String? // set when drawn from a specific coded unit (medicine/vaccine/equipment)
  stock_unit      StockUnit? @relation(fields: [stock_unit_id], references: [id])
  quantity        Decimal    @db.Decimal(10, 3) // feed: allocation amount; medicine: dose drawn; equipment: 1 (non-depleting)
  unit            String
  unitRef         Unit       @relation(fields: [unit], references: [code], onUpdate: Cascade)
  base_quantity   Decimal    @db.Decimal(13, 4) // quantity converted to Item.unit, snapshotted at write time
  date            DateTime
  note            String?
  recorded_by_id  String
  recorded_by     Profiles   @relation(fields: [recorded_by_id], references: [id])
  created_at      DateTime   @default(now())
  idempotency_key String     @unique // client-generated; prevents double-insert on offline sync retry

  medications  Medications[]
  vaccinations Vaccinations[]

  @@index([batch_id])
  @@index([house_id, date])
  @@index([item_id, date])
  @@index([date])
  @@index([stock_unit_id])
}

model Medications {
  id                 String       @id @default(uuid())
  batch_id           String
  batch              Batches      @relation(fields: [batch_id], references: [id])
  consumption_id     String? // links the treatment to the actual stock draw it came from
  consumption        Consumption? @relation(fields: [consumption_id], references: [id])
  medicine_name      String // kept for quick display / manual entries even without a linked consumption
  dosage             String
  cause              String?
  period             String?
  administered_by_id String // any Profile, not just Admins — workers/managers administer treatment day to day
  administered_by    Profiles     @relation(fields: [administered_by_id], references: [id])
  doctor_id          String?
  doctor             Doctors?     @relation(fields: [doctor_id], references: [id])
  remarks            String?
  date               DateTime     @default(now())
  created_at         DateTime     @default(now())
  idempotency_key    String       @unique // client-generated; prevents double-insert on offline sync retry

  @@index([batch_id])
}

model Vaccinations {
  id                 String       @id @default(uuid())
  batch_id           String
  batch              Batches      @relation(fields: [batch_id], references: [id])
  consumption_id     String?
  consumption        Consumption? @relation(fields: [consumption_id], references: [id])
  vaccine_name       String
  dosage             Int
  cause              String?
  period             String?
  administered_by_id String
  administered_by    Profiles     @relation(fields: [administered_by_id], references: [id])
  doctor_id          String?
  doctor             Doctors?     @relation(fields: [doctor_id], references: [id])
  remarks            String?
  date               DateTime     @default(now())
  created_at         DateTime     @default(now())
  idempotency_key    String       @unique // client-generated; prevents double-insert on offline sync retry

  @@index([batch_id])
}

model EnvironmentRecords {
  id               String      @id @default(uuid())
  batch_id         String
  batch            Batches     @relation(fields: [batch_id], references: [id])
  house_id         String
  house            Houses      @relation(fields: [house_id], references: [id])
  temperature_c    Float
  humidity_percent Float
  ammonia_ppm      Float
  co2_ppm          Float
  air_pressure_hpa Float
  time_period      TimePeriods
  recorded_by_id   String
  recorded_by      Profiles    @relation(fields: [recorded_by_id], references: [id])
  recorded_at      DateTime    @default(now())
  idempotency_key  String      @unique // client-generated; prevents double-insert on offline sync retry

  @@index([batch_id])
  @@index([house_id, recorded_at])
}

model WeightRecords {
  id               String   @id @default(uuid())
  batch_id         String?
  batch            Batches? @relation(fields: [batch_id], references: [id])
  house_id         String
  house            Houses   @relation(fields: [house_id], references: [id])
  average_wt_grams Decimal  @db.Decimal(10, 2)
  sample_size      Int
  // The farm-local day of the weighing (Asia/Dhaka, set by the service). A day, not a timestamp: the
  // unique below only means "one sample per day" if the same day is the same key.
  date             DateTime @db.Date
  measured_by_id   String
  measured_by      Profiles @relation(fields: [measured_by_id], references: [id])
  created_at       DateTime @default(now())
  idempotency_key  String   @unique // client-generated; prevents double-insert on offline sync retry

  @@unique([batch_id, house_id, date])
  // A composite unique can't see NULLs (each NULL batch_id is "different"), so an empty-house weighing
  // needs its own: one per house per day when there is no batch.
  @@unique([house_id, date], where: raw("batch_id IS NULL"), map: "WeightRecords_house_date_nobatch_key")
}

model BatchFeedingProgram {
  id              String   @id @default(uuid())
  batch_id        String
  batch           Batches  @relation(fields: [batch_id], references: [id])
  feed_type       FeedType
  item_id         String
  item            Item     @relation(fields: [item_id], references: [id])
  start_day       Int
  end_day         Int?
  idempotency_key String   @unique // client-generated; prevents double-insert on offline sync retry

  @@index([batch_id, start_day, end_day])
}

// ════════════════════════════════════════════════════════════════════
// AGGREGATE LEDGER (non-coded items, e.g. feed at the warehouse level)
// ════════════════════════════════════════════════════════════════════

model StockLedger {
  id              String         @id @default(uuid())
  item_id         String
  item            Item           @relation(fields: [item_id], references: [id])
  quantity        Decimal        @db.Decimal(13, 4)
  direction       StockDirection
  reason          StockReason
  unit_cost       Decimal?       @db.Decimal(14, 4) // per-unit cost: a dose or a gram costs fractions of a taka
  location_type   LocationType?
  location_id     String?
  ref_type        RefType
  ref_id          String
  idempotency_key String         @unique
  occurred_at     DateTime       @default(now())

  @@index([item_id, occurred_at])
  // kept for traceability: "the ledger rows for this purchase line / transfer / adjustment"
  @@index([ref_type, ref_id])
  @@index([location_type, location_id, item_id])
  @@index([occurred_at])
}

model InventoryAdjustment {
  id                  String      @id @default(uuid())
  item_id             String
  item                Item        @relation(fields: [item_id], references: [id], onDelete: Restrict)
  warehouse_id        String?
  warehouse           Warehouses? @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  house_id            String?
  house               Houses?     @relation(fields: [house_id], references: [id], onDelete: Restrict)
  quantity_before     Decimal     @db.Decimal(13, 4)
  quantity_after      Decimal     @db.Decimal(13, 4)
  adjustment_quantity Decimal     @db.Decimal(13, 4)
  reason              String
  note                String?
  recorded_by_id      String
  recorded_by         Profiles    @relation(fields: [recorded_by_id], references: [id])
  created_at          DateTime    @default(now())
  idempotency_key     String      @unique // client-generated; prevents double-insert on offline sync retry

  @@index([item_id])
}

model StockTransfer {
  // Endpoints are WAREHOUSE/HOUSE + id, matching StockLedger's own location_type/location_id
  // convention (no FK -- same tradeoff StockLedger already makes) so a move can start or end at
  // either kind of place: warehouse->house, house->house, or house->warehouse.
  id                 String       @id @default(uuid())
  item_id            String
  item               Item         @relation(fields: [item_id], references: [id])
  from_location_type LocationType
  from_location_id   String
  to_location_type   LocationType
  to_location_id     String
  quantity           Decimal      @db.Decimal(10, 3) // as entered, in `unit`
  unit               String
  unitRef            Unit         @relation(fields: [unit], references: [code], onUpdate: Cascade)
  base_quantity      Decimal      @db.Decimal(13, 4) // quantity converted to Item.unit, snapshotted at write time
  note               String?
  recorded_by_id     String
  recorded_by        Profiles     @relation(fields: [recorded_by_id], references: [id])
  created_at         DateTime     @default(now())
  idempotency_key    String       @unique

  stockHouseAllocations StockHouseAllocation[]

  @@index([item_id])
}

model Warehouses {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())

  inventoryAdjustments InventoryAdjustment[]
  purchases            Purchase[]
}

model Organization {
  id             String   @id @default(uuid())
  label_name     String
  normalized_key String   @unique
  created_at     DateTime @default(now())

  itemLinks ItemOrganization[]
}

model ItemOrganization {
  id              String           @id @default(uuid())
  item_id         String
  item            Item             @relation(fields: [item_id], references: [id], onDelete: Cascade)
  organization_id String
  organization    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  role            OrganizationRole

  @@unique([item_id, organization_id, role])
}

// ════════════════════════════════════════════════════════════════════
// SALES
// ════════════════════════════════════════════════════════════════════

model Sale {
  id             String     @id @default(uuid())
  customer_id    String?
  customer       Customers? @relation(fields: [customer_id], references: [id])
  sale_date      DateTime
  total          Decimal    @db.Decimal(10, 2)
  paid_amount    Decimal    @db.Decimal(10, 2)
  due_amount     Decimal    @db.Decimal(10, 2)
  recorded_by_id String
  recorded_by    Profiles   @relation(fields: [recorded_by_id], references: [id])
  created_at     DateTime   @default(now())

  items SaleItem[]
}

model SaleItem {
  id          String  @id @default(uuid())
  sale_id     String
  sale        Sale    @relation(fields: [sale_id], references: [id])
  item_id     String
  item        Item    @relation(fields: [item_id], references: [id])
  quantity    Decimal @db.Decimal(10, 3)
  unit        String
  unitRef     Unit    @relation(fields: [unit], references: [code], onUpdate: Cascade)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  @@index([sale_id])
  @@index([item_id])
}

model BirdSale {
  id                  String     @id @default(uuid())
  batch_id            String
  batch               Batches    @relation(fields: [batch_id], references: [id])
  house_id            String // which house's BatchHouseBalance this sale depletes -- one of only three things allowed to touch it, alongside BatchHouseAllocation and MortalityLog
  house               Houses     @relation(fields: [house_id], references: [id])
  customer_id         String?
  customer            Customers? @relation(fields: [customer_id], references: [id])
  sale_date           DateTime
  grade               BirdGrade
  male_count          Int?
  female_count        Int?
  birds_count         Int
  dholta_in_g         Decimal    @db.Decimal(10, 2)
  total_katha         Int
  avg_wt_per_katha_kg Decimal?   @db.Decimal(10, 2)
  total_weight        Decimal    @db.Decimal(10, 2)
  net_weight          Decimal    @db.Decimal(10, 2)
  avg_weight_g        Decimal?   @db.Decimal(10, 2)
  price_per_kg        Decimal    @db.Decimal(10, 2)
  total_amount        Decimal    @db.Decimal(10, 2)
  paid_amount         Decimal    @db.Decimal(10, 2)
  // Money knocked off at the point of sale. PoultryScale's gap between its
  // final and received amounts is a discount that can never be paid down --
  // recording it as due would make every discounted sale a permanent
  // uncollectable receivable.
  discount_amount     Decimal    @default(0) @db.Decimal(10, 2)
  due_amount          Decimal    @db.Decimal(10, 2)
  recorded_by_id      String
  recorded_by         Profiles   @relation(fields: [recorded_by_id], references: [id])
  created_at          DateTime   @default(now())

  ingestedSale IngestedSale?

  @@index([batch_id, sale_date])
}

// ════════════════════════════════════════════════════════════════════
// MONEY
// ════════════════════════════════════════════════════════════════════

model Expense {
  id             String                @id @default(uuid())
  batch_id       String?
  batch          Batches?              @relation(fields: [batch_id], references: [id])
  category       String
  categoryRef    ExpenseCategoryLookup @relation(fields: [category], references: [code], onUpdate: Cascade)
  cost_type      CostType
  amount         Decimal               @db.Decimal(10, 2)
  date           DateTime
  remarks        String?
  recorded_by_id String
  recorded_by    Profiles              @relation(fields: [recorded_by_id], references: [id])
  created_at     DateTime              @default(now())

  @@index([batch_id, date])
}

model Payment {
  id                 String             @id @default(uuid())
  amount             Decimal            @db.Decimal(10, 2)
  payment_date       DateTime
  direction          PaymentType
  ref_type           PaymentRefType
  ref_id             String
  // Money moves out of from_instrument and into to_instrument. Either side can be untracked: an incoming
  // payment from a customer has no instrument of ours to leave, so it names only where it landed
  // (to); an outgoing payment to a supplier whose account isn't tracked names only where it came from
  // (from). At least one is always set, and an OUTGOING payment always has a source (CHECKs in the
  // optional_payment_source migration).
  from_instrument_id String?
  from_instrument    PaymentInstrument? @relation("PaymentFrom", fields: [from_instrument_id], references: [id], onDelete: Restrict)
  to_instrument_id   String?
  to_instrument      PaymentInstrument? @relation("PaymentTo", fields: [to_instrument_id], references: [id], onDelete: Restrict)
  transaction_ref    String?
  handled_by_id      String?
  handled_by         Profiles?          @relation(fields: [handled_by_id], references: [id])
  note               String?
  created_at         DateTime           @default(now())

  @@index([ref_type, ref_id])
  @@index([from_instrument_id])
  @@index([to_instrument_id])
}

model PaymentInstrument {
  id         String        @id @default(uuid())
  owner_type UserRole
  owner_id   String
  type       PaymentMethod
  label      String
  bank_name  String?
  account_no String?
  mobile_no  String?
  mfs_type   MfsType?
  is_active  Boolean       @default(true)
  created_at DateTime      @default(now())

  payments_from Payment[] @relation("PaymentFrom")
  payments_to   Payment[] @relation("PaymentTo")
}

// ════════════════════════════════════════════════════════════════════
// PERFORMANCE & PAYROLL
// ════════════════════════════════════════════════════════════════════

model PerformanceScoreEntry {
  id              String               @id @default(uuid())
  employee_id     String
  employee        Employees            @relation(fields: [employee_id], references: [id])
  given_by_id     String
  given_by        Profiles             @relation("ScoreGivenBy", fields: [given_by_id], references: [id])
  // Required when criterion = OTHER, which is also capped at ±5 per employee per
  // month -- enforced in the service, not expressible here.
  approved_by_id  String?
  approved_by     Profiles?            @relation("ScoreApprovedBy", fields: [approved_by_id], references: [id])
  criterion       PerformanceCriterion
  points          Int // signed; snapshot of the criterion's value at time of entry
  reason          String // required — never optional
  // The day it happened, not the day it was typed. A late write-up still belongs
  // to the month it occurred in, so this is what buckets the payroll month.
  incident_date   DateTime
  notice_doc_url  String? // required when points <= -4: written notice comes first
  status          ScoreEntryStatus     @default(ACTIVE)
  void_reason     String? // required when status = VOIDED
  acknowledged_at DateTime? // when the employee confirmed they were shown it
  // Who did each of those, from the session. Null on rows from before logins existed.
  voided_by_id       String?
  voided_by          Profiles?            @relation("ScoreVoidedBy", fields: [voided_by_id], references: [id])
  acknowledged_by_id String?
  acknowledged_by    Profiles?            @relation("ScoreAcknowledgedBy", fields: [acknowledged_by_id], references: [id])
  created_at      DateTime             @default(now())
  idempotency_key String               @unique // client-generated; prevents double-insert on offline sync retry

  @@index([employee_id, incident_date])
}

model PayrollRecord {
  id                 String    @id @default(uuid())
  employee_id        String
  employee           Employees @relation(fields: [employee_id], references: [id])
  month              DateTime // normalized to first-of-month
  // R and the guaranteed wage are snapshotted here, not read back from Employees:
  // a later raise must never rewrite what someone was actually paid in March.
  reference_salary   Decimal   @db.Decimal(10, 2)
  fixed_wage         Decimal   @db.Decimal(10, 2)
  score_sum          Int // raw sum, pre-clamp, kept for audit/history
  // P -- an Int, not a Decimal: a clamped sum of integer points can't carry a fraction.
  adjustment_percent Int
  allowance          Decimal   @db.Decimal(10, 2) // R × (10 + P) / 100, rounded to whole taka
  total_pay          Decimal   @db.Decimal(10, 2) // fixed_wage + allowance
  // Generating payroll locks the month: entries dated inside it are then rejected.
  locked_at          DateTime  @default(now())
  created_at         DateTime  @default(now())

  payout EmployeePayout?

  @@unique([employee_id, month])
}

/// Where an employee's wage is sent. Append-only: a change is a new row plus
/// active_to on the old one, never an edit -- redirecting someone's salary is the
/// most attractive target in a payroll system.
model EmployeePayoutAccount {
  id              String       @id @default(uuid())
  employee_id     String
  employee        Employees    @relation(fields: [employee_id], references: [id])
  method          PayoutMethod
  account_name    String
  account_number  String
  bank_name       String?
  branch_name     String?
  routing_number  String? // 9-digit BEFTN
  holder_relation String? // null = the employee's own account
  verified_by_id  String?
  verified_by     Profiles?    @relation("PayoutAccountVerifiedBy", fields: [verified_by_id], references: [id])
  verified_at     DateTime?
  active_from     DateTime     @default(now())
  active_to       DateTime? // set when superseded
  closed_by_id    String? // who closed or superseded it; null while open
  closed_by       Profiles?    @relation("PayoutAccountClosedBy", fields: [closed_by_id], references: [id])
  created_at      DateTime     @default(now())

  payouts EmployeePayout[]

  @@index([employee_id, active_to])
  // At most one open account per employee, enforced by the database -- the service closes the old
  // one in the same transaction, but two concurrent creates could each close it and insert.
  @@unique([employee_id], where: raw("active_to IS NULL"), map: "EmployeePayoutAccount_one_active_key")
}

/// Paying an employee, as distinct from calculating what they are owed. One payout per
/// payroll record (a month's wage) or per bonus (a festival bonus) -- exactly one of
/// the two links is set (CHECK in the festival_bonus migration; Prisma can't express it).
/// A payout can't be marked paid without proof of transfer, which the generic Payment
/// model has no way to require. Formerly PayrollPayout.
model EmployeePayout {
  id                String                 @id @default(uuid())
  payroll_record_id String?                @unique
  payroll_record    PayrollRecord?         @relation(fields: [payroll_record_id], references: [id])
  bonus_id          String?                @unique
  bonus             Bonus?                 @relation(fields: [bonus_id], references: [id])
  payout_account_id String?
  payout_account    EmployeePayoutAccount? @relation(fields: [payout_account_id], references: [id])
  // Snapshotted even though payout_account_id points at the account: that account
  // can be closed and superseded, but the payout must keep showing where the money went.
  method            PayoutMethod
  account_number    String
  amount            Decimal                @db.Decimal(10, 2)
  fee_paid_by_farm  Decimal                @default(0) @db.Decimal(10, 2)
  transaction_ref   String? // required unless method = CASH
  status            PayoutStatus           @default(PENDING)
  paid_by_id        String?
  paid_by           Profiles?              @relation("PayoutPaidBy", fields: [paid_by_id], references: [id])
  paid_at           DateTime?
  created_at        DateTime               @default(now())
}

/// One festival (or a one-off farm-wide bonus). Creating it writes nothing else: the
/// proposal is computed, then the owner commits the Bonus rows they approve.
model BonusEvent {
  id                 String    @id @default(uuid())
  name               String // "Eid ul-Fitr 2026"
  event_date         DateTime
  /// null = farm-wide (good harvest, one-off); set = only that religion is auto-selected.
  religion           Religion?
  /// × the employee's reference salary. 1.00 = one month's R.
  multiplier         Decimal   @db.Decimal(4, 2)
  /// Full entitlement needs this much continuous service at event_date.
  min_service_months Int       @default(12)
  /// Below the threshold: pay amount × service_months / 12 instead of nothing.
  prorate            Boolean   @default(true)
  created_by_id      String
  created_by         Profiles  @relation(fields: [created_by_id], references: [id])
  created_at         DateTime  @default(now())

  bonuses Bonus[]
}

model Bonus {
  id               String     @id @default(uuid())
  event_id         String
  event            BonusEvent @relation(fields: [event_id], references: [id])
  employee_id      String
  employee         Employees  @relation(fields: [employee_id], references: [id])
  /// Snapshotted together: the event's multiplier and the employee's salary can both move
  /// afterwards, and a paid bonus must keep showing the arithmetic that produced it.
  amount           Decimal    @db.Decimal(10, 2)
  reference_salary Decimal    @db.Decimal(10, 2)
  service_months   Int
  note             String?
  created_at       DateTime   @default(now())

  payout EmployeePayout?

  @@unique([event_id, employee_id]) // makes double-paying one employee at one festival impossible
  @@index([employee_id])
}

model EmployeeTaskAssignment {
  id             String    @id @default(uuid())
  employee_id    String // who does it
  employee       Employees @relation(fields: [employee_id], references: [id])
  assigned_by_id String // who assigned it -- any Profile, same as PerformanceScoreEntry.given_by
  assigned_by    Profiles  @relation(fields: [assigned_by_id], references: [id])
  task_id        String
  task           Tasks     @relation(fields: [task_id], references: [id])

  title       String
  description String?

  // Location is either a house or somewhere else described in free text --
  // never both. Enforced in the service, and expressed in the app as a
  // segmented toggle so the invalid combination can't be entered.
  house_id      String? // null = not house-specific
  house         Houses? @relation(fields: [house_id], references: [id], onDelete: Restrict)
  location_note String? // "front gate", "water line" -- used when house_id is null

  due_at          DateTime
  status          TaskStatus @default(PENDING)
  completed_at    DateTime?
  completion_note String?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  // Completing a task is an idempotent UPDATE and needs no key, but CREATING
  // one is an INSERT a Manager may well make offline -- same reason as the
  // other 12 tables carrying this.
  idempotency_key String   @unique

  @@index([employee_id, status, due_at])
  @@index([house_id])
}

// ════════════════════════════════════════════════════════════════════
// AUDIT
// ════════════════════════════════════════════════════════════════════

model AuditLog {
  id            String      @id @default(uuid())
  table_name    String
  record_id     String
  action        AuditAction
  changed_by_id String
  changed_by    Profiles    @relation(fields: [changed_by_id], references: [id])
  before_data   Json?
  after_data    Json?
  note          String?
  occurred_at   DateTime    @default(now())

  @@index([table_name, record_id])
  @@index([changed_by_id])
}

// ════════════════════════════════════════════════════════════════════
// ALERTS
// ════════════════════════════════════════════════════════════════════

model Alerts {
  id              String            @id @default(uuid())
  title           String
  description     String?
  type            AlertTypes
  level           AlertLevels
  status          AlertStatus       @default(ACTIVE)
  related_id      String?
  action_type     AlertActionTypes?
  issued_at       DateTime?
  resolved_at     DateTime?
  created_at      DateTime          @default(now())
  // A Manager flagging low stock from the field is an offline-capable write.
  // No actor column here yet -- until one exists the app prefixes description
  // with the raiser's name (mobile/docs/PRD.md §6.20).
  idempotency_key String            @unique
  // Names the *condition* a scan alert is about ("NEG_PERF:<employee id>"), so one condition has at
  // most one ACTIVE alert while different conditions about the same employee don't shadow each
  // other. Null for alerts a person raised by hand. Resolving an alert frees its key to be re-raised.
  dedupe_key      String?

  @@unique([dedupe_key], where: raw("status = 'ACTIVE'"), map: "Alerts_one_active_per_condition")
  @@index([status, created_at])
}

// A paired mobile device. Tokens are long-lived deliberately: pairing is the
// only way in, so an expired token would strand a phone holding unsynced sales
// until an admin minted a fresh code. Revocation is immediate instead --
// `revoked_at` is checked on every request.
model Device {
  id           String    @id @default(uuid())
  profile_id   String
  profile      Profiles  @relation(fields: [profile_id], references: [id])
  label        String
  platform     String?
  token_hash   String    @unique // sha256; plaintext is returned once at pairing
  last_seen_at DateTime?
  revoked_at   DateTime?
  revoked_by_id String?
  revoked_by   Profiles? @relation("DeviceRevokedBy", fields: [revoked_by_id], references: [id])
  created_at   DateTime  @default(now())

  ingestedSales IngestedSale[]

  @@index([profile_id])
}

// Single-use, short-lived code an admin generates in the dashboard and the
// operator types into the phone once. Keeps every secret out of the app bundle:
// every EXPO_PUBLIC_* value in PoultryScale is baked into the APK.
model PairingCode {
  code       String    @id
  profile_id String
  profile    Profiles  @relation(fields: [profile_id], references: [id])
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([profile_id])
}

// A weighing session received from a phone, held until a human confirms it.
// `payload` keeps exactly what was sent: when a mapping question comes up later
// the answer is in the row rather than in a reconstruction.
model IngestedSale {
  id              String   @id @default(uuid())
  source          String   @default("poultryscale")
  idempotency_key String   @unique // "<device sale id>:main" | "<device sale id>:cull"
  device_id       String
  device          Device   @relation(fields: [device_id], references: [id])
  recorded_by_id  String
  recorded_by     Profiles @relation(fields: [recorded_by_id], references: [id])

  payload          Json
  portion          IngestPortion
  device_sale_date DateTime
  received_at      DateTime @default(now())

  status           IngestStatus @default(PENDING)
  bird_sale_id     String?   @unique
  birdSale         BirdSale? @relation(fields: [bird_sale_id], references: [id])
  dismissed_reason String?
  reviewed_by_id   String?
  reviewed_by      Profiles? @relation("IngestedSaleReviewer", fields: [reviewed_by_id], references: [id])
  reviewed_at      DateTime?

  @@index([status, received_at])
}
