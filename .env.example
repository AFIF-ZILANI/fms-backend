# Copy to .env and fill in. Validated at startup by src/config/env.ts.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fms?schema=public
# 32+ characters: openssl rand -base64 48
SESSION_SECRET=

PORT=5085
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5085,http://localhost:5173
CORS_CREDENTIALS=true
CSRF_ENABLED=true
# true only behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
TIMEOUT_MS=30000

RATE_LIMIT_MAX=120
SCAN_RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
ALERT_SCAN_INTERVAL_MS=600000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_EMPLOYEE_PRESET=
