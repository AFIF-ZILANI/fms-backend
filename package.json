{
    "name": "zfarm-api",
    "description": "REST API for the ZeroD Farms Management System: poultry flocks, QR-coded stock, finance and payroll",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AFIF-ZILANI/zfarm-api.git"
    },
    "homepage": "https://github.com/AFIF-ZILANI/zfarm-api#readme",
    "bugs": {
        "url": "https://github.com/AFIF-ZILANI/zfarm-api/issues"
    },
    "keywords": [
        "poultry",
        "farm-management",
        "inventory",
        "qr-code",
        "payroll",
        "rest-api",
        "bun",
        "hono",
        "prisma",
        "postgresql"
    ],
    "module": "index.ts",
    "main": "index.js",
    "type": "module",
    "private": true,
    "scripts": {
        "postinstall": "prisma generate",
        "dev": "bun --watch index.ts",
        "dev:node": "node --import tsx index.ts",
        "start": "bun index.ts",
        "start:node": "node --import tsx index.js",
        "build": "bun build index.ts --outdir . --target node",
        "db:generate": "bunx prisma generate",
        "db:migrate": "bunx prisma migrate dev",
        "db:push": "bunx prisma db push",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "auth:set-password": "bun scripts/set-password.ts",
        "docs:endpoints": "bun scripts/gen-endpoints.ts"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^22.0.0",
        "prettier": "^3.8.3",
        "prisma": "^7.8.0",
        "tsx": "^4.19.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@hono/node-server": "^1.14.3",
        "@hono/zod-validator": "^0.8.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "hono": "^4.12.18",
        "hono-rate-limiter": "^0.5.3",
        "zod": "^4.4.3"
    }
}
